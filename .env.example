# Configuración de Base de Datos
DATABASE_URL=sqlite:///./tc_diag.db

# Rutas de Modelos
# Pesos DistilBERT (no incluidos en el repo por tamaño ~2 GB)
# Opción 1: Copiar las subcarpetas en models/distilbert/ y usar ruta local:
DISTILBERT_MODELS_PATH=./models/distilbert
# Opción 2: Apuntar al repositorio de entrenamiento (ruta absoluta):
# DISTILBERT_MODELS_PATH=C:/ruta/al/PDG-Diagnostico-Clinico/models/distilbert

# Umbrales de Confianza (0.0 - 1.0)
PATHOLOGY_MIN_CONFIDENCE=0.70

# Credenciales de Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_GROUP_TO=whatsapp:+57XXXXXXXXXX
